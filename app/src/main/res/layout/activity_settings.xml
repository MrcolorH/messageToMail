<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 服务运行中提示横幅 -->
        <TextView
            android:id="@+id/tvServiceRunningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF3CD"
            android:padding="12dp"
            android:text="⚠️ 服务运行中，请先关闭服务才能修改配置"
            android:textColor="#856404"
            android:visibility="gone" />

        <!-- Tab 切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTabSender"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:text="发件人配置"
                android:textColor="@color/purple_500" />

            <Button
                android:id="@+id/btnTabReceiver"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:text="收件人配置"
                android:textColor="@android:color/darker_gray" />
        </LinearLayout>

        <!-- 发件人配置面板 -->
        <LinearLayout
            android:id="@+id/panelSender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 邮箱类型 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="邮箱类型"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgEmailType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="普通邮箱" />

                <RadioButton
                    android:id="@+id/rbQQ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="QQ邮箱" />
            </RadioGroup>

            <!-- 邮箱账号 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="邮箱账号"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSenderAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入邮箱账号"
                android:inputType="textEmailAddress" />

            <!-- 密码/授权码 -->
            <TextView
                android:id="@+id/tvCredentialLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="授权码"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSenderCredential"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入授权码"
                android:inputType="textPassword" />

            <!-- 提示 -->
            <TextView
                android:id="@+id/tvCredentialHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="提示：QQ邮箱需要使用授权码而非登录密码"
                android:textColor="@android:color/holo_orange_dark"
                android:textSize="12sp" />

            <!-- SMTP服务器 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SMTP服务器"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSmtpHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:hint="自动填充"
                android:inputType="text" />

            <!-- 端口 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="端口"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSmtpPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:hint="自动填充"
                android:inputType="number" />

            <!-- 导入导出 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExportSender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="导出配置" />

                <Button
                    android:id="@+id/btnImportSender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="导入配置" />
            </LinearLayout>

            <!-- 保存按钮 -->
            <Button
                android:id="@+id/btnSaveSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="测试并保存" />

            <!-- 状态提示 -->
            <TextView
                android:id="@+id/tvSenderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="状态：未配置"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 收件人配置面板 -->
        <LinearLayout
            android:id="@+id/panelReceiver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReceiverCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="已添加收件人 (0/10)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 收件人列表容器 -->
            <LinearLayout
                android:id="@+id/containerReceivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 添加新收件人 -->
            <EditText
                android:id="@+id/etNewReceiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="输入收件人邮箱"
                android:inputType="textEmailAddress" />

            <Button
                android:id="@+id/btnAddReceiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="添加" />

            <!-- 导入导出 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExportReceiver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="导出配置" />

                <Button
                    android:id="@+id/btnImportReceiver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="导入配置" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="提示：最多支持10个收件邮箱"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
